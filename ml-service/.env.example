# Copy to .env (git-ignored). See docs/ML_CONTRACT.md and docs/DEVELOPMENT_SETUP.md.
ML_LISTEN_HOST=127.0.0.1
ML_LISTEN_PORT=8001
ML_INTERNAL_TOKEN=change-me-locally
ML_MODEL_DIR=./models
ML_MOCK=1
ML_MOCK_DELAY_MS=1500
ML_MAX_CLIP_BYTES=20971520
ML_LOW_CONFIDENCE_THRESHOLD=0.5

# Generator: "template" (always available) or "openai_compat" (mlx_lm.server on the M4 by default;
# GEN_MODEL is then the absolute path to ml-service/models/Qwen3.5-2B, or "default_model" when the
# server runs with --adapter-path, otherwise the adapter is silently skipped).
GEN_BACKEND=template
GEN_BASE_URL=http://127.0.0.1:8002/v1
GEN_MODEL=
GEN_API_KEY=
GEN_TIMEOUT_S=20
GEN_MAX_TOKENS=96
GEN_DISABLE_THINKING=1
ML_SIGN_LANGUAGE=ase
