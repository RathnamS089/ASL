# Copy to .env (git-ignored) and load it with: set -a; source .env; set +a
API_LISTEN_ADDR=127.0.0.1:8080        # loopback only; Tailscale Serve exposes it to your devices
ML_BASE_URL=http://127.0.0.1:8001
ML_INTERNAL_TOKEN=change-me-locally   # must match ml-service/.env
MOCK_TRANSLATION=0                    # 1 = return contracts/examples/translation-response.json
MOCK_RESPONSE_PATH=../contracts/examples/translation-response.json
WEB_DIST_DIR=../web/dist              # built web app served at /
SIGN_LANGUAGE=ase
MAX_UPLOAD_BYTES=20971520
MIN_CLIP_SECONDS=0.5
MAX_CLIP_SECONDS=10
MAX_SIGNS=8
INFERENCE_CONCURRENCY=1
INFERENCE_QUEUE_DEPTH=4
QUEUE_WAIT=20s
ML_TIMEOUT=45s
RATE_LIMIT_PER_MINUTE=10
TRUST_FORWARDED_FOR=1                 # key rate limits on Tailscale identity / X-Forwarded-For from loopback
CORS_ALLOWED_ORIGINS=                 # empty: same-origin only (the normal case)
